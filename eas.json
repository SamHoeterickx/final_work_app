{
    "cli": {
        "version": ">= 9.0.0"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_API_URL": "https://api.brewlingo.be/graphql"
            }
        },
        "production": {
            "env": {
                "EXPO_PUBLIC_API_URL": "https://api.brewlingo.be/graphql"
            },
            "android": {
                "buildType": "app-bundle"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
